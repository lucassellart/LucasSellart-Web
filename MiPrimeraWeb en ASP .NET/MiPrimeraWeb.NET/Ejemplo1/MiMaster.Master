<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MiMaster.master.cs" Inherits="Ejemplo1.MiMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>

    <!-- css de Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

    <link rel="stylesheet" href="~/Estilos/estilos.css" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <div>
            <header class="sticky-top">     <!-- sticky-top hace que al scrollear, se pueda ver el header (las distintas páginas que tengo) -->

                <!-- Implemento documentación Bootstrap: -->
                <nav class="navbar navbar-expand-lg bg-body-tertiary" data-bs-theme="dark">
                    <div class="container-fluid">
                        <div class="collapse navbar-collapse" id="navbarScroll">
                            <ul class="navbar-nav me-auto my-2 my-lg-0 navbar-nav-scroll" style="--bs-scroll-height: 100px;">

                                <li class="nav-item">
                                    <a class="nav-link active" aria-current="page" href="Perfil.aspx">Perfil</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link active" href="Proyectos.aspx">Proyectos</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link active" aria-current="page" href="Experiencia.aspx">Experiencia</a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link active" aria-current="page" href="Contacto.aspx">Contacto</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>


            </header>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
            <footer>
                <p>footerrrr</p>
            </footer>
        </div>
    </form>
</body>
</html>
